# Host artifacts must never reach the image: pnpm's node_modules is a tree of symlinks
# into the local store, and copying it over the one installed inside the container
# leaves dangling links that fail at build time.
**/node_modules
**/dist
**/dist-test
**/*.tsbuildinfo
.pnpm-store
**/artifacts
test-results/
playwright-report/

.git
.gitignore
.gitattributes

# Secrets and local state
.env
.env.*
!.env.example

# Not needed to build or run the service. The dataset is added back explicitly by the
# branch that imports it.
context/
docs/
data/
# Except the knowledge corpus, which the service does need to run: since the AI contour
# landed, `KnowledgeIndexerService` re-indexes it on every boot and fails the boot when
# it is absent, so an image built without it cannot start at all.
!docs/knowledge
