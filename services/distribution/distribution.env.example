NAVIX_DISTRIBUTION_OPEN=false
NAVIX_PIN_SHA256=replace_with_sha256_of_six_digit_pin
NAVIX_IP_HMAC_KEY=replace_with_random_secret
NAVIX_PAYLOAD_PATH=/payload/navix-data.bin
NAVIX_STATS_DB=/var/lib/navix-distribution/stats.sqlite3
NAVIX_FAILURE_LIMIT=5
NAVIX_FAILURE_WINDOW_SEC=900
NAVIX_TRUST_PROXY=false
