# Public, disposable test credentials. Never load the developer's .env or CI secrets.
POSTGRES_USER=lct
POSTGRES_PASSWORD=regression_database_only
POSTGRES_DB=lct
ROUTER_DB_PASSWORD=regression_router_only
DISPATCHER_EMAIL=dispatcher@regression.test
DISPATCHER_PASSWORD=regression_dispatcher_only
ROUTER_BUDGET_MS=3000
ROUTER_REQUEST_TIMEOUT_MS=30000
# The whole integration suite signs in many times from one loopback address;
# the per-IP auth budgets are the production operator's concern, not a test one.
RATE_LIMIT_MULTIPLIER=1000
