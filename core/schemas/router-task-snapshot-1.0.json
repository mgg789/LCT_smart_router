{
  "$defs": {
    "Depot": {
      "additionalProperties": false,
      "description": "Verified regional office location used only for physical replenishment.",
      "properties": {
        "depot_id": {
          "minLength": 1,
          "title": "Depot Id",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/GeoPoint"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        }
      },
      "required": [
        "depot_id",
        "location"
      ],
      "title": "Depot",
      "type": "object"
    },
    "Engineer": {
      "additionalProperties": false,
      "description": "Prepared continuation point and availability; execution facts belong to sys.",
      "properties": {
        "availability": {
          "enum": [
            "online",
            "offline"
          ],
          "title": "Availability",
          "type": "string"
        },
        "available_from": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Available From"
        },
        "engineer_id": {
          "minLength": 1,
          "title": "Engineer Id",
          "type": "string"
        },
        "equipment_capacity": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Equipment Capacity",
          "type": "integer"
        },
        "equipment_stock": {
          "$ref": "#/$defs/EquipmentStock"
        },
        "expected_online_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Online At"
        },
        "input_order": {
          "minimum": 0,
          "title": "Input Order",
          "type": "integer"
        },
        "lunch": {
          "$ref": "#/$defs/LunchInput"
        },
        "lunch_taken": {
          "title": "Lunch Taken",
          "type": "boolean"
        },
        "region": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "shift_end_at": {
          "minimum": 0,
          "title": "Shift End At",
          "type": "integer"
        },
        "shift_start_at": {
          "minimum": 0,
          "title": "Shift Start At",
          "type": "integer"
        },
        "skills": {
          "items": {
            "enum": [
              "local",
              "connection",
              "emergency"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Skills",
          "type": "array"
        },
        "start_location": {
          "$ref": "#/$defs/GeoPoint"
        },
        "transit_eligible": {
          "default": true,
          "title": "Transit Eligible",
          "type": "boolean"
        },
        "transport_type": {
          "enum": [
            "car",
            "walk",
            "bike",
            "transit"
          ],
          "title": "Transport Type",
          "type": "string"
        }
      },
      "required": [
        "engineer_id",
        "input_order",
        "skills",
        "transport_type",
        "shift_start_at",
        "shift_end_at",
        "start_location",
        "available_from",
        "availability",
        "expected_online_at",
        "lunch_taken",
        "lunch",
        "equipment_stock"
      ],
      "title": "Engineer",
      "type": "object"
    },
    "EquipmentLogistics": {
      "additionalProperties": false,
      "description": "One-sided equipment movement attached to the job it unblocks.\n\nUnlike ``EquipmentHandoff``, a delivery is a stop only for its donor and an\noffice pickup is a stop only for its recipient.  The System Layer owns the\nauthenticated stock fact; Router only schedules this immutable intention.",
      "properties": {
        "depot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depot Id"
        },
        "donor_engineer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Donor Engineer Id"
        },
        "equipment_type": {
          "enum": [
            "router",
            "set_top_box",
            "smart_speaker"
          ],
          "title": "Equipment Type",
          "type": "string"
        },
        "kind": {
          "enum": [
            "donor_delivery",
            "office_pickup"
          ],
          "title": "Kind",
          "type": "string"
        },
        "logistics_id": {
          "minLength": 1,
          "title": "Logistics Id",
          "type": "string"
        },
        "receiver_engineer_id": {
          "minLength": 1,
          "title": "Receiver Engineer Id",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "logistics_id",
        "kind",
        "request_id",
        "equipment_type",
        "receiver_engineer_id"
      ],
      "title": "EquipmentLogistics",
      "type": "object"
    },
    "EquipmentStock": {
      "additionalProperties": false,
      "description": "Immutable start-of-day stock carried by one engineer.",
      "properties": {
        "router": {
          "default": 0,
          "minimum": 0,
          "title": "Router",
          "type": "integer"
        },
        "set_top_box": {
          "default": 0,
          "minimum": 0,
          "title": "Set Top Box",
          "type": "integer"
        },
        "smart_speaker": {
          "default": 0,
          "minimum": 0,
          "title": "Smart Speaker",
          "type": "integer"
        }
      },
      "title": "EquipmentStock",
      "type": "object"
    },
    "GeoPoint": {
      "additionalProperties": false,
      "description": "WGS84 geographic coordinates in degrees, never GeoJSON lon/lat arrays.",
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "GeoPoint",
      "type": "object"
    },
    "LunchInput": {
      "additionalProperties": false,
      "description": "Normalized absolute lunch window supplied by sys, with no invented defaults.",
      "properties": {
        "duration_sec": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration Sec"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "window_end_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Window End At"
        },
        "window_start_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Window Start At"
        }
      },
      "required": [
        "enabled",
        "duration_sec",
        "window_start_at",
        "window_end_at",
        "required"
      ],
      "title": "LunchInput",
      "type": "object"
    },
    "PendingEquipmentHandoff": {
      "additionalProperties": false,
      "description": "Sys-confirmed meeting retained as a frozen future execution fact.",
      "properties": {
        "donor_engineer_id": {
          "minLength": 1,
          "title": "Donor Engineer Id",
          "type": "string"
        },
        "handoff_id": {
          "minLength": 1,
          "title": "Handoff Id",
          "type": "string"
        },
        "items": {
          "$ref": "#/$defs/EquipmentStock"
        },
        "location": {
          "$ref": "#/$defs/GeoPoint"
        },
        "meeting_at": {
          "minimum": 0,
          "title": "Meeting At",
          "type": "integer"
        },
        "receiver_engineer_id": {
          "minLength": 1,
          "title": "Receiver Engineer Id",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "handoff_id",
        "donor_engineer_id",
        "receiver_engineer_id",
        "request_id",
        "items",
        "location",
        "meeting_at"
      ],
      "title": "PendingEquipmentHandoff",
      "type": "object"
    },
    "PendingEquipmentLogistics": {
      "additionalProperties": false,
      "description": "Accepted one-sided movement replayed at its frozen time on later replans.",
      "properties": {
        "at": {
          "minimum": 0,
          "title": "At",
          "type": "integer"
        },
        "location": {
          "$ref": "#/$defs/GeoPoint"
        },
        "logistics": {
          "$ref": "#/$defs/EquipmentLogistics"
        }
      },
      "required": [
        "logistics",
        "location",
        "at"
      ],
      "title": "PendingEquipmentLogistics",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "description": "Supported catalog choice; preferences cannot disable hard constraints.",
      "properties": {
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        },
        "policy_id": {
          "enum": [
            "fast",
            "compact",
            "sla",
            "balanced",
            "eco",
            "covering"
          ],
          "title": "Policy Id",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "parameters"
      ],
      "title": "Policy",
      "type": "object"
    },
    "Request": {
      "additionalProperties": false,
      "description": "An unstarted job; its customer window constrains service start only.",
      "properties": {
        "arrival_order": {
          "minimum": 0,
          "title": "Arrival Order",
          "type": "integer"
        },
        "dispatcher_priority": {
          "default": false,
          "title": "Dispatcher Priority",
          "type": "boolean"
        },
        "location": {
          "$ref": "#/$defs/GeoPoint"
        },
        "priority": {
          "enum": [
            "normal",
            "urgent"
          ],
          "title": "Priority",
          "type": "string"
        },
        "received_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Received At"
        },
        "region": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "required_equipment": {
          "anyOf": [
            {
              "enum": [
                "router",
                "set_top_box",
                "smart_speaker"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Equipment"
        },
        "required_skill": {
          "enum": [
            "local",
            "connection",
            "emergency"
          ],
          "title": "Required Skill",
          "type": "string"
        },
        "required_transport": {
          "anyOf": [
            {
              "enum": [
                "car",
                "walk",
                "bike",
                "transit"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Required Transport"
        },
        "service_duration_sec": {
          "exclusiveMinimum": 0,
          "title": "Service Duration Sec",
          "type": "integer"
        },
        "source_window_end_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Window End At"
        },
        "source_window_start_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Window Start At"
        },
        "window_end_at": {
          "minimum": 0,
          "title": "Window End At",
          "type": "integer"
        },
        "window_start_at": {
          "minimum": 0,
          "title": "Window Start At",
          "type": "integer"
        },
        "work_category": {
          "anyOf": [
            {
              "enum": [
                "emergency",
                "connection",
                "service"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Work Category"
        }
      },
      "required": [
        "request_id",
        "arrival_order",
        "location",
        "service_duration_sec",
        "window_start_at",
        "window_end_at",
        "priority",
        "required_skill",
        "required_transport"
      ],
      "title": "Request",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete remaining-work projection, published atomically by sys.",
  "properties": {
    "depots": {
      "items": {
        "$ref": "#/$defs/Depot"
      },
      "title": "Depots",
      "type": "array"
    },
    "engineers": {
      "items": {
        "$ref": "#/$defs/Engineer"
      },
      "title": "Engineers",
      "type": "array"
    },
    "horizon_end_at": {
      "minimum": 0,
      "title": "Horizon End At",
      "type": "integer"
    },
    "horizon_start_at": {
      "minimum": 0,
      "title": "Horizon Start At",
      "type": "integer"
    },
    "pending_equipment_handoffs": {
      "items": {
        "$ref": "#/$defs/PendingEquipmentHandoff"
      },
      "title": "Pending Equipment Handoffs",
      "type": "array"
    },
    "pending_equipment_logistics": {
      "items": {
        "$ref": "#/$defs/PendingEquipmentLogistics"
      },
      "title": "Pending Equipment Logistics",
      "type": "array"
    },
    "planning_as_of": {
      "minimum": 0,
      "title": "Planning As Of",
      "type": "integer"
    },
    "policy": {
      "$ref": "#/$defs/Policy"
    },
    "requests": {
      "items": {
        "$ref": "#/$defs/Request"
      },
      "title": "Requests",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "planning_as_of",
    "horizon_start_at",
    "horizon_end_at",
    "requests",
    "engineers",
    "policy"
  ],
  "title": "RouterTaskSnapshot",
  "type": "object"
}
