{
  "$defs": {
    "PlanMetrics": {
      "additionalProperties": false,
      "description": "Snapshot-remaining totals; lunch-only engineers do not count as used.",
      "properties": {
        "assigned_count": {
          "default": 0,
          "title": "Assigned Count",
          "type": "integer"
        },
        "distance_km": {
          "default": 0.0,
          "title": "Distance Km",
          "type": "number"
        },
        "engineers_used": {
          "default": 0,
          "title": "Engineers Used",
          "type": "integer"
        },
        "late_assigned_count": {
          "default": 0,
          "title": "Late Assigned Count",
          "type": "integer"
        },
        "lunch_time_sec": {
          "default": 0,
          "title": "Lunch Time Sec",
          "type": "integer"
        },
        "max_workload_sec": {
          "default": 0,
          "title": "Max Workload Sec",
          "type": "integer"
        },
        "min_window_slack_sec": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Window Slack Sec"
        },
        "requests_total": {
          "default": 0,
          "title": "Requests Total",
          "type": "integer"
        },
        "total_lateness_sec": {
          "default": 0,
          "title": "Total Lateness Sec",
          "type": "integer"
        },
        "travel_time_sec": {
          "default": 0,
          "title": "Travel Time Sec",
          "type": "integer"
        },
        "unassigned_count": {
          "default": 0,
          "title": "Unassigned Count",
          "type": "integer"
        },
        "urgent_assigned_count": {
          "default": 0,
          "title": "Urgent Assigned Count",
          "type": "integer"
        },
        "urgent_total": {
          "default": 0,
          "title": "Urgent Total",
          "type": "integer"
        },
        "waiting_time_sec": {
          "default": 0,
          "title": "Waiting Time Sec",
          "type": "integer"
        },
        "work_time_sec": {
          "default": 0,
          "title": "Work Time Sec",
          "type": "integer"
        },
        "workload_spread_sec": {
          "default": 0,
          "title": "Workload Spread Sec",
          "type": "integer"
        }
      },
      "title": "PlanMetrics",
      "type": "object"
    },
    "PolicyComparisonRow": {
      "additionalProperties": false,
      "description": "One independently calculated strategy on the shared comparison snapshot.",
      "properties": {
        "additional_engineers": {
          "default": 0,
          "minimum": 0,
          "title": "Additional Engineers",
          "type": "integer"
        },
        "calculation_ms": {
          "minimum": 0,
          "title": "Calculation Ms",
          "type": "integer"
        },
        "is_usable": {
          "title": "Is Usable",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "policy",
            "baseline"
          ],
          "title": "Kind",
          "type": "string"
        },
        "strategy_id": {
          "enum": [
            "fast",
            "compact",
            "sla",
            "balanced",
            "eco",
            "covering",
            "baseline"
          ],
          "title": "Strategy Id",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/PlanMetrics"
        }
      },
      "required": [
        "strategy_id",
        "kind",
        "is_usable",
        "calculation_ms",
        "summary"
      ],
      "title": "PolicyComparisonRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Cached comparison; covering explicitly reports its additional workforce.",
  "properties": {
    "computed_at": {
      "minimum": 0,
      "title": "Computed At",
      "type": "integer"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "input_publication_id": {
      "minLength": 1,
      "title": "Input Publication Id",
      "type": "string"
    },
    "router_context_version": {
      "minLength": 1,
      "title": "Router Context Version",
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/PolicyComparisonRow"
      },
      "maxItems": 7,
      "minItems": 7,
      "title": "Rows",
      "type": "array"
    },
    "search_budget_ms": {
      "exclusiveMinimum": 0,
      "maximum": 8000,
      "title": "Search Budget Ms",
      "type": "integer"
    }
  },
  "required": [
    "input_publication_id",
    "input_hash",
    "router_context_version",
    "computed_at",
    "search_budget_ms",
    "rows"
  ],
  "title": "PolicyComparison",
  "type": "object"
}
