# Ignore OS noise
.DS_Store
Thumbs.db
.ruff_cache/

# Future code artifacts
node_modules/
__pycache__/
.venv/
dist/
.env

# Agents local workspace state
.zcode/
.mimosa/
.cursor/
.claude/
.codex/
# Local tool state (Mimosa security plugin, ruff)
.mimosa/
.ruff_cache/

# Node / TypeScript build artifacts
*.tsbuildinfo
.pnpm-store/
apps/*/dist/
apps/*/dist-test/
apps/*/generated/
apps/api/src/generated/
coverage/
artifacts/
test-results/
playwright-report/

# Local environment files (only .env.example is committed)
.env.*
!.env.example

