// Data Layer of the LCT Smart Router.
//
// Canon: context/37 (Data Layer), context/36 (System Layer states), context/33 (Router
// contract). Names here are physical; the semantic areas they implement are the ones
// named in context/37 section 2.
//
// Conventions that hold everywhere in this file:
//   * every absolute moment and every duration is whole seconds, stored as BigInt
//     (context/33 section 4). Conversion to a JSON-safe number happens at the read
//     boundary, never by a global serializer patch;
//   * `version` is an optimistic-concurrency counter. A write based on a value the actor
//     read carries the version it saw; a mismatch is a reported conflict, never a silent
//     overwrite (context/36 section 8);
//   * rows are not deleted to express a business outcome. Cancellation, revocation and
//     completion are states with their own timestamps, because history has to survive.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  runtime                = "nodejs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

// Prisma 7 no longer accepts a connection URL here: the migration URL lives in
// prisma.config.ts and the runtime connection is supplied by a driver adapter.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Reference values. Codes come from context/33 section 4; their Russian meanings
// in the case statement are mapped in docs/data.md.
// ---------------------------------------------------------------------------

enum Role {
  client
  engineer
  dispatcher
}

enum Skill {
  local
  connection
  emergency
}

enum TransportType {
  car
  walk
  bike
  transit
}

/// Portable customer equipment carried by one engineer for one working day.
/// Stock is intentionally engineer-owned in v0: there is no transfer between routes.
enum EquipmentType {
  router
  set_top_box
  smart_speaker
}

enum Priority {
  normal
  urgent
}

/// Business stage of a request. Deliberately separate from its assignment outcome and
/// from the visit's progress: collapsing them into one status was rejected in
/// context/36 section 3.
enum RequestLifecycle {
  draft
  submitted
  in_progress
  completed
  cancelled
}

/// Outcome of distribution, owned by the accepted automatic result or by the manual
/// plan. `pending` means "waiting for a current result"; it is not an error or a refusal.
enum AssignmentState {
  pending
  assigned
  unassigned
}

/// Working availability of an engineer. Never a statement about network connectivity,
/// and `online` does not mean "free right now" (context/32 section 5.2).
enum Availability {
  online
  offline
}

/// Durable lifecycle of the one dispatcher-controlled LIVE session for a work date.
/// It is deliberately separate from routing snapshots: a plan may be rebuilt many
/// times during one started day without resetting the business clock.
enum LiveWorkdayStatus {
  pending
  running
  finished
}

/// UI and audit state of an engineer in LIVE. Availability remains the Router-facing
/// capacity flag; line status explains why it has that value.
enum LiveEngineerLineStatus {
  pending
  online
  no_show_offline
  technical_break
}

/// An engineer-reported operational problem. The request lifecycle remains the
/// authoritative business outcome; this code preserves the reason for LIVE views.
enum LiveProblemKind {
  delay
  missing_equipment
  other
  impossible
}

/// How a request's time window came to be, so an assumption is never mistaken for data
/// the customer actually gave (context/18 section 6.2).
enum WindowOrigin {
  explicit
  declared_full_day
  missing_treated_as_full_day
}

enum ControlMode {
  auto
  manual
}

enum PlanOrigin {
  auto
  manual
  /// A dispatcher restored the immediately preceding immutable revision after revalidation.
  restore
}

/// Confirmed execution facts. Every one of them comes from an explicit mark by the
/// engineer; none is ever produced by a timer (context/36 section 5.2).
enum FactKind {
  arrived
  arrived_blocked
  started
  finished
  problem
  lunch_started
  lunch_finished
}

/// A signed immutable reward entry. Positive categories come from explicit facts;
/// penalties are manual dispatcher decisions with an audited reason.
enum EngineerRewardCategory {
  arrival
  completion
  passport
  penalty
}

enum StopKind {
  handoff
  job
  lunch
  wait
}

enum AlertSeverity {
  info
  warning
  error
}

/// Where a change came from. The source never replaces the authorization check; it
/// exists so the journal can tell a human click from an integration call
/// (context/41 section 3.3).
enum ActorSource {
  ui
  external_api
  ai_run
  system
}

enum ActorKind {
  account
  api_token
  system
}

/// Outcome of a system operation. An applied write, a refused one and an unknown result
/// must stay distinguishable (context/36 section 12).
enum OperationState {
  applied
  rejected
  conflict
  outcome_unknown
}

/// Mail catalogue of context/36 section 10.
///
/// The 2026-09-20 product decision supersedes the earlier "no completion mail" rule:
/// every customer-visible transition of a request now has a letter, and an engineer
/// gets one day-summary mail when their day is closed. There is deliberately still no
/// pre-visit reminder (nothing in the system observes time passing for a customer).
enum NotificationCategory {
  account_login_code
  request_received
  engineer_assigned
  engineer_confirmed
  visit_change_required
  request_rescheduled
  request_cancelled
  request_completed
  engineer_day_summary
  dispatcher_monthly_report
  engineer_attention_required
  plan_rebuilt
}

/// Lifecycle of a mail intent. There is no `delivered` state: our control ends when the
/// external SMTP server accepts the message (context/35, context/42 DF-20).
enum NotificationState {
  pending_submission
  accepted_by_server
  rejected
  submission_unknown
  expired_before_submission
}

/// Provenance of a stored value. `synthesized` marks data the importer derived by a
/// documented rule because the dataset does not contain it -- allowed by the case
/// statement, but it has to stay visible (context/18 section 6.3).
enum DataOrigin {
  import
  manual
  system_rule
  synthesized
}

/// Which interface an integration key replaces. `client_eng` covers integrations that
/// speak to both the client and the engineer contours with one key (2026-09-19 amendment
/// to context/41 section 5); `master` covers those plus the dispatcher contour and the
/// system/debug functions.
enum ApiTokenCategory {
  client
  eng
  client_eng
  master
}

/// Physical access technology recorded for a building, never inferred from a request.
enum ConnectionType {
  fiber
  ethernet
  dsl
  radio
  other
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

model Account {
  id        String @id @default(uuid())
  /// Stored lower-cased; the application normalises before writing.
  email     String @unique
  /// The customer's right to silence (card #65, 2026-09-20): when false, event letters
  /// stop. Login codes ignore this flag -- a way in must never be silenceable.
  mailNotificationsEnabled Boolean @default(true) @map("mail_notifications_enabled")
  createdAt BigInt @map("created_at")
  updatedAt BigInt @map("updated_at")
  version   Int    @default(1)

  roles           AccountRole[]
  sessions        Session[]
  engineer        Engineer?
  requests        Request[]
  aiConversations AiConversation[]

  @@map("accounts")
}

/// Roles are granted, never claimed. A matching email address does not raise an
/// account's role (context/36 section 7.3).
model AccountRole {
  accountId String @map("account_id")
  role      Role
  grantedAt BigInt @map("granted_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, role])
  @@map("account_roles")
}

/// One-time email login code. Only the hash is stored, so a database dump cannot be
/// replayed as a login.
model LoginCode {
  id         String  @id @default(uuid())
  email      String
  codeHash   String @map("code_hash")
  issuedAt   BigInt @map("issued_at")
  expiresAt  BigInt @map("expires_at")
  attempts   Int     @default(0)
  consumedAt BigInt? @map("consumed_at")

  @@index([email, expiresAt])
  @@map("login_codes")
}

model Session {
  id String @id @default(uuid())

  accountId String @map("account_id")
  /// The role this session acts as. An account holding several roles gets one session
  /// per role rather than an ambient "highest" role.
  role      Role
  tokenHash String  @unique @map("token_hash")
  createdAt BigInt @map("created_at")
  expiresAt BigInt @map("expires_at")
  revokedAt BigInt? @map("revoked_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("sessions")
}

/// Integration key of the single dispatcher: full access inside its category, no
/// per-user binding, valid until deleted (context/41 sections 3-4). Only the hash is
/// stored and the secret is shown exactly once.
model ApiToken {
  id        String           @id @default(uuid())
  name      String
  category  ApiTokenCategory
  tokenHash String           @unique @map("token_hash")
  createdAt BigInt @map("created_at")
  /// Unix-epoch seconds. NULL is the deliberate never-expiring key; a passed date stops
  /// new calls exactly like a revocation (2026-09-19 amendment to context/41 section 4.2).
  expiresAt BigInt? @map("expires_at")
  revokedAt BigInt? @map("revoked_at")

  @@map("api_tokens")
}

// ---------------------------------------------------------------------------
// Engineers
// ---------------------------------------------------------------------------

/// Stable properties of an engineer. Everything that belongs to one working day lives in
/// EngineerDay instead, so that "already had lunch today" can never become a permanent
/// property of the person (context/37 section 3.2).
model Engineer {
  id String @id @default(uuid())

  /// Absent while the dispatcher has a routing profile for someone who has no login yet
  /// (context/37 section 3.1).
  accountId     String?       @unique @map("account_id")
  displayName   String @map("display_name")
  /// Order of appearance in the input. The baseline picks the first suitable engineer in
  /// this order, so it must never be replaced by a technical sort (context/33 section 5).
  inputOrder    Int @map("input_order")
  skills        Skill[]
  transportType TransportType @map("transport_type")
  /// Explicitly sourced pedestrian crews may be prohibited from public transit.
  /// True preserves the historic walking-profile behaviour for existing data.
  transitEligible Boolean @default(true) @map("transit_eligible")
  depotId       String? @map("depot_id")
  /// Usual start point. May be absent; it is never filled with invented coordinates.
  homeLat       Float? @map("home_lat")
  homeLon       Float? @map("home_lon")
  region        String?
  origin        DataOrigin
  createdAt     BigInt @map("created_at")
  updatedAt     BigInt @map("updated_at")
  archivedAt    BigInt? @map("archived_at")
  version       Int           @default(1)

  account Account?      @relation(fields: [accountId], references: [id])
  depot   Depot?        @relation(fields: [depotId], references: [id])
  days    EngineerDay[]
  facts   RequestFact[]
  liveStates LiveEngineerState[]
  passportPoints EngineerPassportPoint[]
  rewards EngineerReward[]

  @@index([inputOrder])
  @@map("engineers")
}

/// State of one engineer on one working day.
model EngineerDay {
  id String @id @default(uuid())

  engineerId         String @map("engineer_id")
  /// Local calendar day as `YYYY-MM-DD`. The absolute shift bounds next to it are the
  /// authoritative values.
  workDate           String @map("work_date")
  shiftStartAt       BigInt @map("shift_start_at")
  shiftEndAt         BigInt @map("shift_end_at")
  availability       Availability @default(online)
  /// Forecast return from a technical stop. Reaching it creates no fact by itself.
  expectedOnlineAt   BigInt? @map("expected_online_at")
  lunchEnabled       Boolean      @default(false) @map("lunch_enabled")
  lunchDurationSec   Int? @map("lunch_duration_sec")
  lunchWindowStartAt BigInt? @map("lunch_window_start_at")
  lunchWindowEndAt   BigInt? @map("lunch_window_end_at")
  /// Set by the dispatcher's explicit "restore lunch" operation. It is never silently
  /// cleared because the task did not solve (context/33 section 6).
  lunchRequired      Boolean      @default(false) @map("lunch_required")
  /// Set by sys when the engineer actually starts lunch, not when a plan schedules one.
  /// True means the single lunch of the day is used up, not that it has finished.
  lunchTaken         Boolean      @default(false) @map("lunch_taken")
  lunchStartedAt     BigInt? @map("lunch_started_at")
  /// An engineer may explicitly opt out of silence monitoring for this day. This does
  /// not take them off the line and is visible to the dispatcher.
  attendanceOptOut   Boolean @default(false) @map("attendance_opt_out")
  /// Confirmed app activity/check-in. A timer never invents this fact.
  lastAttendanceAt   BigInt? @map("last_attendance_at")
  /// Explicit call-in grace for an additional engineer, never inferred from silence.
  attendanceGraceUntil BigInt? @map("attendance_grace_until")
  /// Morning stock already including the one spare unit for every used equipment kind.
  equipmentRouter       Int @default(0) @map("equipment_router")
  equipmentSetTopBox    Int @default(0) @map("equipment_set_top_box")
  equipmentSmartSpeaker Int @default(0) @map("equipment_smart_speaker")
  /// First accepted plan freezes the physical morning issue for the rest of the day.
  equipmentIssuedAt BigInt? @map("equipment_issued_at")
  createdAt          BigInt @map("created_at")
  updatedAt          BigInt @map("updated_at")
  version            Int          @default(1)

  engineer Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@unique([engineerId, workDate])
  @@map("engineer_days")
}

/// Regional office. In the official dataset every region has exactly one, hidden in the
/// last row of the file (context/18 section 6.4).
model Depot {
  id          String     @id @default(uuid())
  region      String     @unique
  addressText String @map("address_text")
  lat         Float?
  lon         Float?
  origin      DataOrigin
  createdAt   BigInt @map("created_at")

  engineers Engineer[]

  @@map("depots")
}

// ---------------------------------------------------------------------------
// Requests, their history and confirmed facts
// ---------------------------------------------------------------------------

model Request {
  id String @id @default(uuid())

  clientAccountId    String? @map("client_account_id")
  /// Arrival order: the baseline's iteration order (context/33 section 5).
  arrivalOrder       Int @map("arrival_order")
  addressText        String @map("address_text")
  district           String?
  region             String?
  /// Absent until the address is geocoded. A request without a point is excluded from the
  /// published snapshot with a counted diagnostic, never given invented coordinates.
  lat                Float?
  lon                Float?
  needsGeocoding     Boolean          @default(true) @map("needs_geocoding")
  /// Canonical normative profile selected from `workTypeHd` by System Layer.
  normProfileCode    String @map("norm_profile_code")
  /// Reference road allowance from the normative workbook. Router keeps it separate
  /// from on-site work and decides whether to use it or graph travel.
  normativeTravelDurationSec Int @map("normative_travel_duration_sec")
  technicalDurationSec       Int @map("technical_duration_sec")
  documentationDurationSec   Int @map("documentation_duration_sec")
  /// Technical plus documentation time. Road time is deliberately excluded.
  serviceDurationSec Int @map("service_duration_sec")
  /// Window for the *start* of the work, not for its end (context/33 section 5).
  windowStartAt      BigInt @map("window_start_at")
  windowEndAt        BigInt @map("window_end_at")
  windowOrigin       WindowOrigin     @default(explicit) @map("window_origin")
  priority           Priority         @default(normal)
  requiredSkill      Skill @map("required_skill")
  /// Null means the request places no transport restriction.
  requiredTransport  TransportType? @map("required_transport")
  /// Null means that the visit consumes no portable customer equipment.
  requiredEquipment  EquipmentType? @map("required_equipment")
  /// Source work type, kept so a derived skill or duration can be traced back.
  workTypeHd         String? @map("work_type_hd")
  lifecycle          RequestLifecycle @default(draft)
  assignmentState    AssignmentState  @default(pending) @map("assignment_state")
  origin             DataOrigin
  problemText        String? @map("problem_text")
  contactName        String? @map("contact_name")
  createdAt          BigInt @map("created_at")
  submittedAt        BigInt? @map("submitted_at")
  startedAt          BigInt? @map("started_at")
  /// Forecast captured when work starts; reaching it never finishes the request.
  expectedCompletionAt BigInt? @map("expected_completion_at")
  /// Time from which routing may schedule the engineer again. It starts as the expected
  /// completion and changes to the confirmed finish only for a material variance.
  continuationAvailableAt BigInt? @map("continuation_available_at")
  /// First time System Layer observed an overrun beyond the configured tolerance.
  overrunDetectedAt  BigInt? @map("overrun_detected_at")
  completedAt        BigInt? @map("completed_at")
  cancelledAt        BigInt? @map("cancelled_at")
  updatedAt          BigInt @map("updated_at")
  version            Int              @default(1)

  clientAccount Account?                  @relation(fields: [clientAccountId], references: [id])
  history       RequestConditionHistory[]
  facts         RequestFact[]
  assignments   AppliedPlanAssignment[]
  stops         AppliedPlanStop[]
  liveStates    LiveRequestState[]
  rewards       EngineerReward[]

  @@index([lifecycle, assignmentState])
  @@index([arrivalOrder])
  @@map("requests")
}

/// A canonical building address. It is resolved before a passport write, so an outage
/// cannot silently merge nearby coordinates into one physical object.
model Building {
  id               String @id @default(uuid())
  canonicalAddress String @unique @map("canonical_address")
  createdAt        BigInt @map("created_at")
  updatedAt        BigInt @map("updated_at")

  passport ObjectPassport?

  @@map("buildings")
}

/// Durable LocationIQ reverse results. Coordinate keys are rounded only for cache
/// lookup; the stored canonical address is always provider/fixture supplied.
model ReverseGeocodeCache {
  coordinateKey    String @id @map("coordinate_key")
  canonicalAddress String @map("canonical_address")
  provider         String
  resolvedAt       BigInt @map("resolved_at")

  @@map("reverse_geocode_cache")
}

/// One current object passport per building. New saves replace fields on this row;
/// Operations and the points ledger preserve the historical who/when trail.
model ObjectPassport {
  id             String @id @default(uuid())
  buildingId     String @unique @map("building_id")
  connectionType ConnectionType @map("connection_type")
  difficulty     Int
  equipment      String?
  accessNotes    String? @map("access_notes")
  comment        String?
  updatedAt      BigInt @map("updated_at")

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@map("object_passports")
}

/// Immutable reward entries. The operation id is unique so a transport retry cannot
/// award a second 35-point update even if the operation journal is later inspected.
model EngineerPassportPoint {
  id          String @id @default(uuid())
  engineerId  String @map("engineer_id")
  operationId String @unique @map("operation_id")
  points      Int
  awardedAt   BigInt @map("awarded_at")

  engineer Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@index([engineerId, awardedAt])
  @@map("engineer_passport_points")
}

/// Unified immutable engineer reward ledger. `awardedAt` is the wall-clock month
/// bucket; evidence may include the logical LIVE timestamp of the action.
model EngineerReward {
  id          String                 @id @default(uuid())
  engineerId  String                 @map("engineer_id")
  requestId   String?                @map("request_id")
  workdayId   String?                @map("workday_id")
  category    EngineerRewardCategory
  points      Int
  operationId String                 @unique @map("operation_id")
  dedupKey    String                 @unique @map("dedup_key")
  awardedAt   BigInt                 @map("awarded_at")
  reason      String
  evidence    Json

  engineer Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  request  Request?  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([engineerId, awardedAt])
  @@index([workdayId])
  @@map("engineer_rewards")
}

/// Previous conditions of a request. A reschedule replaces the single set of live
/// conditions on the same request id; the old window lives here and is never a second
/// active promise to the customer (context/36 section 4).
model RequestConditionHistory {
  id          String  @id @default(uuid())
  requestId   String @map("request_id")
  changedAt   BigInt @map("changed_at")
  operationId String? @map("operation_id")
  /// The conditions as they were before the change.
  previous    Json
  reason      String?

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, changedAt])
  @@map("request_condition_history")
}

model RequestFact {
  id String @id @default(uuid())

  requestId   String @map("request_id")
  engineerId  String? @map("engineer_id")
  kind        FactKind
  /// When it happened, according to the reporting engineer.
  occurredAt  BigInt @map("occurred_at")
  /// When sys stored it. The two differ and neither may be substituted for the other.
  recordedAt  BigInt @map("recorded_at")
  note        String?
  operationId String? @map("operation_id")
  /// Immutable calibration evidence captured with the confirmed fact; never inferred later.
  metadata    Json?

  request  Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  engineer Engineer? @relation(fields: [engineerId], references: [id])

  @@index([requestId, occurredAt])
  @@map("request_facts")
}

/// Region/day weather history cached for offline calibration replay after one archive fetch.
model WeatherDayCache {
  region      String
  workDate    String @map("work_date")
  locationHash String @map("location_hash")
  weatherCode Int    @map("weather_code")
  kind        String
  fetchedAt   BigInt @map("fetched_at")

  @@id([region, workDate])
  @@index([workDate])
  @@map("weather_day_cache")
}

/// Immutable paired prediction evidence; labels are attached only after later confirmed finish.
model WeatherRiskPrediction {
  planId              String @map("plan_id")
  requestId           String @map("request_id")
  engineerId          String @map("engineer_id")
  region              String
  transportType       TransportType @map("transport_type")
  weatherKind         String @map("weather_kind")
  workDate            String @map("work_date")
  candidateVersion    String @map("candidate_version")
  inputHash           String @map("input_hash")
  routerContextVersion String @map("router_context_version")
  predictedAt         BigInt @map("predicted_at")
  baselineProbability Float @map("baseline_probability")
  candidateProbability Float @map("candidate_probability")
  breachAfterAt       BigInt @map("breach_after_at")
  actualBreach        Boolean? @map("actual_breach")
  resolvedAt          BigInt? @map("resolved_at")

  @@id([planId, requestId, candidateVersion])
  @@index([region, transportType, weatherKind, workDate, candidateVersion])
  @@map("weather_risk_predictions")
}

// ---------------------------------------------------------------------------
// LIVE workday state
// ---------------------------------------------------------------------------

/// A started dispatcher session and its virtual business timeline. `startedAtWallSec`
/// is only used to derive the virtual clock; every planning value remains Unix seconds
/// in the existing logical timeline.
model LiveWorkday {
  id               String            @id @default(uuid())
  generation       Int
  workDate         String            @map("work_date")
  status           LiveWorkdayStatus @default(pending)
  logicalStartAt   BigInt            @map("logical_start_at")
  logicalEndAt     BigInt            @map("logical_end_at")
  startedAtWallSec BigInt?           @map("started_at_wall_sec")
  finishedAt       BigInt?           @map("finished_at")
  completionReason String?           @map("completion_reason")
  speedDurationSec Int?              @map("speed_duration_sec")
  createdAt        BigInt            @map("created_at")
  updatedAt        BigInt            @map("updated_at")
  version          Int               @default(1)

  engineers LiveEngineerState[]
  requests  LiveRequestState[]

  @@unique([generation, workDate])
  @@index([status, workDate])
  @@map("live_workdays")
}

/// Per-engineer LIVE presence and technical-break state. These fields never replace
/// confirmed execution facts or the persistent routing availability in EngineerDay.
model LiveEngineerState {
  id                    String                 @id @default(uuid())
  workdayId             String                 @map("workday_id")
  engineerId            String                 @map("engineer_id")
  lineStatus            LiveEngineerLineStatus @default(pending) @map("line_status")
  lineStartedAt         BigInt?                @map("line_started_at")
  noShowAt              BigInt?                @map("no_show_at")
  technicalBreakStartedAt BigInt?              @map("technical_break_started_at")
  technicalBreakPlannedEndAt BigInt?           @map("technical_break_planned_end_at")
  technicalBreakOverdueAt BigInt?              @map("technical_break_overdue_at")
  /// Last request vertex that the engineer explicitly or silently reached. It remains
  /// visible after finish/cancellation until the next request is started.
  routeAnchorRequestId    String?                @map("route_anchor_request_id")
  routeAnchorReachedAt    BigInt?                @map("route_anchor_reached_at")
  routeAnchorDepartedAt   BigInt?                @map("route_anchor_departed_at")
  /// Immutable first vertex of the LIVE workday. Replans must never relocate it.
  routeOriginLat          Float?                 @map("route_origin_lat")
  routeOriginLon          Float?                 @map("route_origin_lon")
  routeOriginAt           BigInt?                @map("route_origin_at")
  /// Coordinates of an entered automatic lunch. They outlive a remaining-day replan
  /// that correctly removes the consumed lunch stop from Router input.
  activeLunchLat          Float?                 @map("active_lunch_lat")
  activeLunchLon          Float?                 @map("active_lunch_lon")
  activeLunchStartedAt    BigInt?                @map("active_lunch_started_at")
  createdAt             BigInt                 @map("created_at")
  updatedAt             BigInt                 @map("updated_at")
  version               Int                    @default(1)

  workday  LiveWorkday @relation(fields: [workdayId], references: [id], onDelete: Cascade)
  engineer Engineer    @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@unique([workdayId, engineerId])
  @@index([engineerId])
  @@index([routeAnchorRequestId])
  @@map("live_engineer_states")
}

/// LIVE-only interpretation of a request. `assumedCompletedAt` records the explicit
/// product rule that an engineer who does not mark anything is assumed to follow the
/// schedule; it is not a fabricated RequestFact or a Request.lifecycle transition.
model LiveRequestState {
  id                    String          @id @default(uuid())
  workdayId             String          @map("workday_id")
  requestId             String          @map("request_id")
  assumedStartedAt      BigInt?         @map("assumed_started_at")
  assumedCompletedAt    BigInt?         @map("assumed_completed_at")
  reportedEtaAt         BigInt?         @map("reported_eta_at")
  reportedEtaRecordedAt BigInt?         @map("reported_eta_recorded_at")
  reportedEtaBaselineAt BigInt?         @map("reported_eta_baseline_at")
  promisedFinishAt      BigInt?         @map("promised_finish_at")
  promisedFinishRecordedAt BigInt?      @map("promised_finish_recorded_at")
  promisedFinishBaselineAt BigInt?      @map("promised_finish_baseline_at")
  /// Latest accepted promise audit data used by revised-timing reward policy.
  /// Original plan owner pinned by an explicit ETA while Router rebuilds the remainder.
  reservedEngineerId    String?         @map("reserved_engineer_id")
  /// An infeasible ETA invalidates this engineer's current accepted route until a newer
  /// plan revision arrives. The request itself remains available to every Router candidate.
  replanPendingEngineerId String?        @map("replan_pending_engineer_id")
  replanPendingPlanRevision Int?         @map("replan_pending_plan_revision")
  replanRequestedAt      BigInt?         @map("replan_requested_at")
  problemKind           LiveProblemKind? @map("problem_kind")
  problemNote           String?         @map("problem_note")
  additionalDurationSec Int?            @map("additional_duration_sec")
  createdAt             BigInt          @map("created_at")
  updatedAt             BigInt          @map("updated_at")
  version               Int             @default(1)

  workday LiveWorkday @relation(fields: [workdayId], references: [id], onDelete: Cascade)
  request Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([workdayId, requestId])
  @@index([requestId])
  @@map("live_request_states")
}

// ---------------------------------------------------------------------------
// Published input sector for Router Core
// ---------------------------------------------------------------------------

/// Immutable published snapshot: a whole task, not a stream of create/update/delete.
model RoutingSnapshot {
  id String @id @default(uuid())

  /// Exact serialized bytes of the RouterTaskSnapshot, stored as text.
  ///
  /// Not jsonb on purpose: jsonb normalises whitespace and key order, while sys and
  /// Router must hash an identical byte sequence (context/43 section 5.2).
  payload      String
  /// SHA-256 of `payload`. Kept beside the document and never inside it: a hash cannot
  /// be part of its own input.
  inputHash    String @map("input_hash")
  /// SHA-256 of the task **without** `planning_as_of`.
  ///
  /// `input_hash` covers the whole published document, including its timestamp, which is
  /// what Router matches a result against. That makes it useless for answering "did the
  /// task actually change", because the timestamp moves every second. The contract is
  /// explicit that the change check happens *before* the time is updated
  /// (context/33 section 7), so the comparison uses this fingerprint instead.
  taskFingerprint String @map("task_fingerprint")
  /// Moment of this publication of changed data. It does not tick on its own and is not
  /// advanced by a read (context/33 section 7).
  planningAsOf BigInt @map("planning_as_of")
  createdAt    BigInt @map("created_at")
  /// Which business event justified the publication. There is no timer trigger.
  trigger      String
  /// Working-set generation, so a late write from before a reset cannot be applied to
  /// the new one (context/37 section 9.6).
  generation   Int    @default(1)
  /// What the projection had to leave out, for example requests still lacking
  /// coordinates. Diagnostics are shown, not silently dropped.
  diagnostics  Json

  current RoutingCurrent?

  @@index([inputHash])
  @@index([createdAt])
  @@map("routing_snapshots")
}

/// Pointer to the snapshot Router must read. Switched in the same transaction that
/// inserts the snapshot; `pointerVersion` stops a late publisher from moving it back to
/// an older projection (context/37 section 4.2).
model RoutingCurrent {
  id             String @id @default("singleton")
  snapshotId     String @unique @map("snapshot_id")
  pointerVersion Int    @default(1) @map("pointer_version")
  updatedAt      BigInt @map("updated_at")

  snapshot RoutingSnapshot @relation(fields: [snapshotId], references: [id])

  @@map("routing_current")
}

// ---------------------------------------------------------------------------
// Router results and the applied working plan
// ---------------------------------------------------------------------------

/// A received Router package, stored whether or not it was applied, so that a refusal
/// can still be explained afterwards.
model RouterResult {
  id String @id @default(uuid())

  resultId             String  @unique @map("result_id")
  inputHash            String @map("input_hash")
  routerContextVersion String @map("router_context_version")
  status               String
  planningAsOf         BigInt? @map("planning_as_of")
  computedAt           BigInt? @map("computed_at")
  receivedAt           BigInt @map("received_at")
  accepted             Boolean @default(false)
  /// Error code of the acceptance check that refused it, if any.
  rejectionCode        String? @map("rejection_code")
  payload              Json

  appliedPlans AppliedPlan[]

  @@index([inputHash])
  @@map("router_results")
}

/// One immutable revision of the working plan. A new revision is added, never edited, so
/// history and diffs come for free (D-10).
model AppliedPlan {
  id String @id @default(uuid())

  revision       Int        @unique @default(autoincrement())
  origin         PlanOrigin
  routerResultId String? @map("router_result_id")
  /// Snapshot against which a restored revision was revalidated; source result stays immutable.
  validatedInputHash String? @map("validated_input_hash")
  /// The moment the shown plan describes: `planningAsOf` of the applied result, or the
  /// time of the manual edit. Never the timestamp of a newer, not yet computed snapshot
  /// (context/36 section 6).
  planAsOf       BigInt @map("plan_as_of")
  appliedAt      BigInt @map("applied_at")
  createdBy      String? @map("created_by")
  note           String?

  routerResult RouterResult?           @relation(fields: [routerResultId], references: [id])
  routes       AppliedPlanRoute[]
  assignments  AppliedPlanAssignment[]
  current      AppliedPlanCurrent?

  @@map("applied_plans")
}

/// Pointer to the revision the interfaces work from.
model AppliedPlanCurrent {
  id             String @id @default("singleton")
  planId         String @unique @map("plan_id")
  pointerVersion Int    @default(1) @map("pointer_version")
  updatedAt      BigInt @map("updated_at")

  plan AppliedPlan @relation(fields: [planId], references: [id])

  @@map("applied_plan_current")
}

model AppliedPlanRoute {
  id String @id @default(uuid())

  planId         String @map("plan_id")
  engineerId     String @map("engineer_id")
  startLat       Float @map("start_lat")
  startLon       Float @map("start_lon")
  startAt        BigInt? @map("start_at")
  finishAt       BigInt? @map("finish_at")
  distanceKm     Float   @default(0) @map("distance_km")
  travelTimeSec  Int     @default(0) @map("travel_time_sec")
  workTimeSec    Int     @default(0) @map("work_time_sec")
  waitingTimeSec Int     @default(0) @map("waiting_time_sec")
  lunchTimeSec   Int     @default(0) @map("lunch_time_sec")
  assignedCount  Int     @default(0) @map("assigned_count")
  /// One of the distinguishable lunch outcomes of context/33 section 8.
  lunchStatus    String @map("lunch_status")
  /// Router-produced travel legs, including optional road geometry and source fidelity.
  legs           Json   @default("[]")
  reasons        Json

  plan  AppliedPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  stops AppliedPlanStop[]

  @@unique([planId, engineerId])
  @@map("applied_plan_routes")
}

model AppliedPlanStop {
  id String @id @default(uuid())

  routeId   String @map("route_id")
  sequence  Int
  kind      StopKind
  requestId String? @map("request_id")
  handoff   Json?
  lat       Float
  lon       Float
  /// Computed schedule, not confirmed facts: arrival <= start <= end.
  arrivalAt BigInt @map("arrival_at")
  startAt   BigInt @map("start_at")
  endAt     BigInt @map("end_at")

  route   AppliedPlanRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  request Request?         @relation(fields: [requestId], references: [id])

  @@unique([routeId, sequence])
  @@map("applied_plan_stops")
}

/// Exactly one outcome per request of the snapshot the plan was built from.
model AppliedPlanAssignment {
  id String @id @default(uuid())

  planId     String @map("plan_id")
  requestId  String @map("request_id")
  status     AssignmentState
  engineerId String? @map("engineer_id")
  stopId     String? @map("stop_id")
  /// Structured, checkable grounds from the solver -- never a hand-written sentence and
  /// never model-generated text (context/11, D-3).
  reasons    Json

  plan    AppliedPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  request Request     @relation(fields: [requestId], references: [id])

  @@unique([planId, requestId])
  @@map("applied_plan_assignments")
}

/// AUTO/MANUAL and the version of that control state.
///
/// Acceptance of a result re-reads this row under a lock, so a result that was already
/// in flight cannot land after the dispatcher took manual control (context/36 section 6).
model ControlState {
  id           String      @id @default("singleton")
  mode         ControlMode @default(auto)
  modeVersion  Int         @default(1) @map("mode_version")
  changedAt    BigInt @map("changed_at")
  changedBy    String? @map("changed_by")
  /// The revision frozen as the starting point when manual mode was switched on.
  frozenPlanId String? @map("frozen_plan_id")

  @@map("control_state")
}

// ---------------------------------------------------------------------------
// Dispatcher-facing catalogues
// ---------------------------------------------------------------------------

/// Supported policies: a catalogue of prepared variants, not a place to store executable
/// user input. The Dashboard is not a formula editor (context/33 section 5).
model Policy {
  policyId    String  @id @map("policy_id")
  title       String
  description String
  isDefault   Boolean @default(false) @map("is_default")
  parameters  Json

  @@map("policies")
}

model ActivePolicy {
  id         String  @id @default("singleton")
  policyId   String @map("policy_id")
  parameters Json
  version    Int     @default(1)
  changedAt  BigInt @map("changed_at")
  changedBy  String? @map("changed_by")

  @@map("active_policy")
}

/// Explainable problem for the dispatcher. Marking it seen changes the seen flag only;
/// it does not resolve the underlying condition (context/39 DB2).
model Alert {
  id String @id @default(uuid())

  /// `alert` needs a dispatcher decision; `notice` is informational and never blocks
  /// closing the day.
  kind           String @default("alert")
  dedupKey       String? @unique @map("dedup_key")
  code           String
  severity       AlertSeverity
  engineerIds    String[] @map("engineer_ids")
  requestIds     String[] @map("request_ids")
  reasons        Json
  /// A verified restore option, or null. A guess is never presented as a guaranteed fix
  /// (context/33 section 6).
  restoreOption  Json? @map("restore_option")
  sourceResultId String? @map("source_result_id")
  workDate       String? @map("work_date")
  isBlocking     Boolean @default(true) @map("is_blocking")
  createdAt      BigInt @map("created_at")
  seenAt         BigInt? @map("seen_at")
  resolvedAt     BigInt? @map("resolved_at")
  invalidatedAt  BigInt? @map("invalidated_at")
  resolutionAction String? @map("resolution_action")
  resolutionReason String? @map("resolution_reason")
  resolutionDelaySec Int? @map("resolution_delay_sec")

  @@index([createdAt])
  @@index([workDate, resolvedAt, invalidatedAt])
  @@map("alerts")
}

/// A dispatcher closes a local work day only after every decision-required alert has a
/// recorded outcome. The row is retained as an audit fact rather than inferred later.
model ShiftClosure {
  workDate  String @id @map("work_date")
  closedAt  BigInt @map("closed_at")
  closedBy  String? @map("closed_by")
  operationId String @unique @map("operation_id")

  @@map("shift_closures")
}

// ---------------------------------------------------------------------------
// System bookkeeping
// ---------------------------------------------------------------------------

/// One business operation, stored so that a retry returns the first outcome instead of
/// doing the work twice (context/36 section 12).
model Operation {
  operationId String @id @map("operation_id")

  actorKind          ActorKind @map("actor_kind")
  actorId            String? @map("actor_id")
  source             ActorSource
  action             String
  targetRef          String? @map("target_ref")
  /// Hash of the arguments. The same id with different arguments is a caller bug and is
  /// refused, not stored as a second write.
  payloadFingerprint String @map("payload_fingerprint")
  state              OperationState
  response           Json?
  createdAt          BigInt @map("created_at")
  completedAt        BigInt? @map("completed_at")

  @@index([createdAt])
  @@map("operations")
}

/// The journal called `eternal-log` in the concept. The user made it explicit that
/// "eternal" is only a name and the data needs a lifetime, hence `retainUntil`
/// (context/37 section 6.2).
model AuditLog {
  id String @id @default(uuid())

  at          BigInt
  actorKind   ActorKind @map("actor_kind")
  actorId     String? @map("actor_id")
  source      ActorSource
  action      String
  targetRef   String? @map("target_ref")
  operationId String? @map("operation_id")
  details     Json
  retainUntil BigInt? @map("retain_until")

  @@index([at])
  @@index([targetRef])
  @@map("audit_log")
}

/// A mail sys has prepared. The SMTP-gateway drains the `pending_submission` rows,
/// submits them and records the server's acceptance; whether a mailbox was reached is
/// outside our control, so there is no `delivered` state (context/35 section 13).
///
/// `businessEventKey` is the deduplication key: one letter per business transition, not
/// per result read. A new result that repeats the same assignment is not a new reason to
/// write to the customer (context/36 section 10).
model NotificationIntent {
  id String @id @default(uuid())

  category         NotificationCategory
  businessEventKey String               @unique @map("business_event_key")
  recipientEmail   String @map("recipient_email")
  payload          Json
  state            NotificationState    @default(pending_submission)
  createdAt        BigInt @map("created_at")
  submittedAt      BigInt? @map("submitted_at")
  error            String?

  @@index([state])
  @@map("notification_intents")
}

/// Small service state that must survive a restart: whether the application was ever
/// initialised, which startup profile was chosen, the current reset generation.
///
/// An empty `requests` table is not by itself proof that the system was never
/// initialised -- that is exactly why this table exists (context/37 section 9.5).
model AppState {
  key       String @id
  value     Json
  updatedAt BigInt @map("updated_at")

  @@map("app_state")
}

/// An accepted data package. The checksum makes a repeated load recognisable by content
/// and origin rather than by file name (context/37 section 9.1).
model ImportPackage {
  id String @id @default(uuid())

  source     String
  checksum   String
  appliedAt  BigInt @map("applied_at")
  generation Int    @default(1)
  summary    Json

  @@unique([source, checksum])
  @@map("import_packages")
}

/// Immutable normalized import batches awaiting explicit dispatcher confirmation.
model ImportPreparation {
  id                 String  @id @default(uuid())
  source             String
  status             String  @default("prepared")
  ownerKind          String  @map("owner_kind")
  ownerId            String  @map("owner_id")
  immutableBatchHash String  @map("immutable_batch_hash")
  versions           String
  payload            String
  findings           String
  createdAt          BigInt  @map("created_at")
  expiresAt          BigInt  @map("expires_at")
  confirmedAt        BigInt? @map("confirmed_at")
  cancelledAt        BigInt? @map("cancelled_at")
  operationId        String? @unique @map("operation_id")
  response           String?

  @@index([ownerKind, ownerId, status])
  @@index([expiresAt])
  @@map("import_preparations")
}

/// source + entity type + external id -> internal id. Deleting the API key that imported
/// the data must not make this mapping unresolvable (context/41 section 7.2).
model ExternalIdMap {
  id String @id @default(uuid())

  source     String
  entityType String @map("entity_type")
  externalId String @map("external_id")
  internalId String @map("internal_id")
  createdAt  BigInt @map("created_at")

  @@unique([source, entityType, externalId])
  @@index([internalId])
  @@map("external_id_map")
}

/// Accepted paired meeting. Stock moves once, only after both authenticated confirmations.
model EquipmentHandoff {
  id String @id
  workDate String @map("work_date")
  donorEngineerId String @map("donor_engineer_id")
  receiverEngineerId String @map("receiver_engineer_id")
  requestId String @map("request_id")
  items Json
  lat Float
  lon Float
  meetingAt BigInt @map("meeting_at")
  donorConfirmedAt BigInt? @map("donor_confirmed_at")
  receiverConfirmedAt BigInt? @map("receiver_confirmed_at")
  completedAt BigInt? @map("completed_at")
  createdAt BigInt @map("created_at")
  @@index([workDate, completedAt])
  @@map("equipment_handoffs")
}

enum AiRoleProfile {
  client
  engineer
  dispatcher_readonly
  dispatcher_fix
}

/// While a conversation is `dispatcher`, the assistant writes nothing into it: a human
/// has taken the turn and an AI reply landing on top of theirs is exactly the failure
/// this mode exists to prevent.
enum AiConversationMode {
  ai
  dispatcher
}

/// A new dispatcher dialogue always starts in `help`; `fix` is only entered by an
/// explicit request for a change, never inferred from wording.
enum AiAssistMode {
  help
  fix
}

enum AiMessageAuthor {
  user
  assistant
  dispatcher
  system
}

/// Exactly the four agreed UI forms. Nothing else is ever generated, so a renderer never
/// has to guess how to draw a message.
enum AiMessageKind {
  text
  text_action
  text_action_cancel
  text_confirmation
}

enum AiRunState {
  running
  stopping
  stopped
  completed
  failed
}

/// A user-requested stop must never be shown as a rollback of an applied write, hence
/// `cancelled_before_apply` and `outcome_unknown` are their own states rather than a
/// reuse of `rejected` (mirrors the applied/rejected/conflict/outcome_unknown split on
/// the system-wide OperationState).
enum AiOperationState {
  prepared
  awaiting_confirmation
  running
  applied
  rejected
  cancelled_before_apply
  outcome_unknown
}

enum AiKnowledgeSegment {
  client
  engineer
  dispatcher
}

enum AiHandoffState {
  waiting
  answered
  closed
}

/// Who opened the handover. A dialogue the dispatcher started themselves is never
/// «waiting for a dispatcher», so the queue badge must be able to tell the two apart
/// without inspecting who wrote the first message.
enum AiHandoffOrigin {
  user
  dispatcher
}

enum AiProviderKind {
  agents
  openai_chat
  replay
}

// ---------------------------------------------------------------------------
// AI gateway
// ---------------------------------------------------------------------------

/// One AI or dispatcher-handoff dialogue. `roleProfile` is fixed by the server at
/// creation from the session that opened it and is never revised later, even if the
/// account gains or loses a role, so a run's tool access cannot silently drift mid
/// conversation.
model AiConversation {
  id String @id @default(uuid())

  accountId String @map("account_id")
  role      Role
  roleProfile AiRoleProfile @map("role_profile")
  /// Switches to `dispatcher` once a handoff is answered; the assistant stays silent for
  /// the rest of that mode so an AI reply can never land on top of a dispatcher's.
  mode        AiConversationMode @default(ai)
  /// Starts every dispatcher dialogue asking questions; only an explicit request for a
  /// change moves it to `fix`.
  assistMode  AiAssistMode @default(help) @map("assist_mode")
  /// Which request/engineer/alert the dialogue was opened about, if any. Kept as loose
  /// JSON because the set of linkable entities is expected to grow without a migration.
  contextRef  Json? @map("context_ref")
  title       String?
  createdAt   BigInt @map("created_at")
  updatedAt   BigInt @map("updated_at")
  lastMessageAt BigInt @map("last_message_at")
  /// A conversation is archived, never deleted; closing is a state with its own moment,
  /// like every other lifecycle in this schema.
  closedAt    BigInt? @map("closed_at")
  version     Int @default(1)

  account    Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages   AiMessage[]
  runs       AiRun[]
  operations AiOperation[]
  handoffs   AiHandoff[]

  /// "My chats": an account's own conversation list, newest first.
  @@index([accountId, lastMessageAt])
  /// The dispatcher handover queue: dialogues currently waiting on a human, newest first.
  @@index([mode, lastMessageAt])
  @@map("ai_conversations")
}

/// One turn in a conversation. `seq` is the paging cursor; at one-second resolution
/// `createdAt` alone cannot order two messages written in the same tick.
model AiMessage {
  id String @id @default(uuid())

  conversationId String @map("conversation_id")
  seq            Int
  author         AiMessageAuthor
  kind           AiMessageKind @default(text)
  text           String
  /// Button descriptors: each one a reference to an allowed system action, never a URL or
  /// script supplied by the model.
  actions        Json @default("[]")
  runId          String? @map("run_id")
  operationId    String? @map("operation_id")
  /// Set only for `dispatcher` authorship, so a reply can be attributed to the human who
  /// actually sent it.
  authorAccountId String? @map("author_account_id")
  createdAt      BigInt @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// The paging cursor for `?afterSeq=` reads within one conversation.
  @@unique([conversationId, seq])
  @@map("ai_messages")
}

/// One model invocation and its budget reservation. Actual spend is settled into
/// AiBudget; this row is the per-call record of what was reserved and used.
model AiRun {
  id String @id @default(uuid())

  conversationId String @map("conversation_id")
  accountId      String @map("account_id")
  /// Copied from the active quota bucket at start, so a later calendar-day rollover or an
  /// account change can never move an already-charged run onto a different bucket.
  quotaDay       String @map("quota_day")
  quotaAccountId String @map("quota_account_id")
  roleProfile    AiRoleProfile @map("role_profile")
  state          AiRunState @default(running)
  providerKind   AiProviderKind @map("provider_kind")
  model          String
  /// Shared across retries AND the one fallback hop to a secondary provider, so neither
  /// can multiply the other into an unbounded retry storm.
  attempts       Int @default(0)
  usedFallback   Boolean @default(false) @map("used_fallback")
  /// Null until the provider reports usage: a stalled or failed-before-response run must
  /// not read as a zero-cost success.
  promptTokens     Int? @map("prompt_tokens")
  completionTokens Int? @map("completion_tokens")
  costMicros     Int @default(0) @map("cost_micros")
  reservedMicros Int @map("reserved_micros")
  /// Mirrors the highest AiRunEvent.seq already written, so a resuming client's
  /// `?afterSeq=` has an upper bound without a separate query.
  lastEventSeq   Int @default(0) @map("last_event_seq")
  stopRequestedAt BigInt? @map("stop_requested_at")
  startedAt      BigInt @map("started_at")
  finishedAt     BigInt? @map("finished_at")
  errorCode      String? @map("error_code")
  version        Int @default(1)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  events       AiRunEvent[]

  /// The startup sweep that reconciles runs a restart left stuck in `running`/`stopping`.
  @@index([state, startedAt])
  @@map("ai_runs")
}

/// Append-only stream of what happened during a run, replayed to a reconnecting client
/// from its last known position.
model AiRunEvent {
  id String @id @default(uuid())

  runId     String @map("run_id")
  seq       Int
  type      String
  payload   Json
  createdAt BigInt @map("created_at")

  run AiRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// The cursor that makes `?afterSeq=` resumption a range scan instead of a sort of the
  /// whole run.
  @@unique([runId, seq])
  @@map("ai_run_events")
}

/// A proposed system write staged by the AI (or resumed by a dispatcher), shown to the
/// actor as a confirmable card before OperationsService is ever called. `id` is the
/// public operation reference shown in the chat -- distinct from `resultOperationId`,
/// which only exists once the write actually happened.
model AiOperation {
  id String @id @default(uuid())

  conversationId String @map("conversation_id")
  runId          String? @map("run_id")
  accountId      String @map("account_id")
  /// The same catalogue string the HTTP controller passes to OperationsService, e.g.
  /// `request.submit` -- there is exactly one vocabulary of writable actions, not a
  /// parallel one for AI-originated calls.
  action         String
  targetRef      String? @map("target_ref")
  payload        Json
  /// Canonical hash of `payload`, re-checked at confirm time: content edited after the
  /// card was shown forces a new card instead of silently confirming stale arguments.
  payloadFingerprint String @map("payload_fingerprint")
  /// Safe public preview rendered by the server, never by the model -- the chat displays
  /// this, not `payload`.
  summary        Json
  expectedVersion Int? @map("expected_version")
  requiresConfirmation Boolean @default(true) @map("requires_confirmation")
  state          AiOperationState @default(awaiting_confirmation)
  createdAt      BigInt @map("created_at")
  expiresAt      BigInt @map("expires_at")
  confirmedAt    BigInt? @map("confirmed_at")
  completedAt    BigInt? @map("completed_at")
  /// Links to the row OperationsService wrote in the `operations` journal once this card
  /// was actually applied.
  resultOperationId String? @map("result_operation_id")
  result         Json?
  version        Int @default(1)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// The card list shown inside one conversation.
  @@index([conversationId, state])
  /// The expiry sweep across every pending card.
  @@index([state, expiresAt])
  @@map("ai_operations")
}

/// Atomic per-day, per-account spend ledger, separate from AiRun so a reservation can be
/// checked and taken before the run that will spend it even exists.
model AiBudget {
  quotaDay       String @map("quota_day")
  accountId      String @map("account_id")
  reservedMicros Int @default(0) @map("reserved_micros")
  settledMicros  Int @default(0) @map("settled_micros")
  messageCount   Int @default(0) @map("message_count")
  updatedAt      BigInt @map("updated_at")
  version        Int @default(1)

  /// Not an optimisation but the correctness anchor for an atomic `INSERT ... ON
  /// CONFLICT DO UPDATE ... WHERE` reservation, so two browser tabs cannot both pass the
  /// same remaining-balance check.
  @@id([quotaDay, accountId])
  @@map("ai_budgets")
}

/// One stretch of a dialogue carried by a human instead of the assistant, from the moment
/// it is handed over to the moment the dispatcher ends it. `requestIds`/`engineerIds` are
/// the working set the dispatcher is being asked about, not a resolved plan or an
/// assignment.
///
/// A closed row is history, not litter: the dispatcher's list keeps showing it after the
/// handover ends, and a later escalation of the same dialogue creates a *new* row rather
/// than reopening this one. That is what makes "how many times did we have to step in"
/// answerable from the table alone.
model AiHandoff {
  id String @id @default(uuid())

  conversationId        String @map("conversation_id")
  /// Who asked for the handover: the client or engineer when the assistant escalated,
  /// the dispatcher themselves when they opened the chat from the dashboard.
  requestedByAccountId  String @map("requested_by_account_id")
  /// Always the *counterpart's* role -- the client or engineer on the other side of the
  /// chat -- never `dispatcher`, whichever side opened it. The dispatcher's list groups
  /// by this field, so it has to mean the same thing in both directions.
  actorRole             Role @map("actor_role")
  initiatedBy           AiHandoffOrigin @default(user) @map("initiated_by")
  requestIds            String[] @map("request_ids")
  engineerIds           String[] @map("engineer_ids")
  state                 AiHandoffState @default(waiting)
  /// Highest message `seq` the dispatcher has acknowledged in this handover; the unread
  /// badge counts the counterpart's messages above it. Per handover rather than per
  /// account because this product has one dispatcher (context/32 section 2.1) -- a second
  /// one would need a separate read-cursor table, not a change to this column.
  dispatcherLastReadSeq Int @default(0) @map("dispatcher_last_read_seq")
  /// Message `seq` the dialogue had reached when the handover opened, and the one it had
  /// reached when it ended. Together they make an episode a real object: the dispatcher's
  /// list can draw the "handed over here" divider at the right place, and a chat closed
  /// last week keeps showing the conversation as it stood then instead of silently
  /// growing new messages the person who closed it never saw.
  startSeq              Int @default(0) @map("start_seq")
  endSeq                Int? @map("end_seq")
  createdAt             BigInt @map("created_at")
  firstReplyAt          BigInt? @map("first_reply_at")
  closedAt              BigInt? @map("closed_at")
  closedByAccountId     String? @map("closed_by_account_id")
  version               Int @default(1)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// The dispatcher's chat list: open handovers first, then closed ones, newest first.
  @@index([state, createdAt])
  @@map("ai_handoffs")
}

/// One curated knowledge card served to the assistant's retrieval step. Content is
/// authored by the team, never generated, and `sourcePath` keeps every row traceable back
/// to the file it was built from.
model AiDocument {
  id String @id @default(uuid())

  segment    AiKnowledgeSegment
  slug       String
  section    String
  title      String
  summary    String
  body       String
  tags       String[]
  actions    String[]
  checksum   String
  sourcePath String @map("source_path")
  updatedAt  BigInt @map("updated_at")

  @@unique([slug, section])
  @@index([segment])
  @@map("ai_documents")
}

/// What-if answer for one publication, context and patch. Never the applied plan.
model PlanSimulation {
  id             String @id
  baseHash       String @map("base_hash")
  contextVersion String @map("context_version")
  patchHash      String @map("patch_hash")
  patch          Json
  method         String
  summary        Json
  routes         Json
  delta          Json
  createdAt      BigInt @map("created_at")

  @@unique([baseHash, contextVersion, patchHash])
  @@index([baseHash, createdAt])
  @@map("plan_simulations")
}

/// Shared fixed-window request budgets. The composite key lets every API instance
/// increment one bucket atomically without an in-memory or per-process bypass.
model RateLimitBucket {
  scope       String
  clientKey   String @map("client_key")
  windowStart BigInt @map("window_start")
  count       Int
  updatedAt   BigInt @map("updated_at")

  @@id([scope, clientKey, windowStart])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}
