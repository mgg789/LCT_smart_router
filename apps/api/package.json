{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "LCT Smart Router — System Layer (sys): business state, operations, snapshot publication, plan application",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-report-assets.cjs dist",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/src/main.js",
    "start": "node dist/src/main.js",
    "test:build": "node -e \"require('node:fs').rmSync('dist-test', { recursive: true, force: true })\" && tsc -p tsconfig.json && node scripts/copy-report-assets.cjs dist-test",
    "test": "pnpm test:build && node --test --test-concurrency=1 \"dist-test/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "pnpm test:build && node dist-test/scripts/smoke.js",
    "knowledge:index": "pnpm test:build && node dist-test/scripts/index-knowledge.js"
  },
  "dependencies": {
    "@lct/shared": "workspace:*",
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@openai/agents": "0.18.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "^10.53.1",
    "csv-parse": "7.0.2",
    "dotenv": "^17.4.2",
    "helmet": "8.3.0",
    "iconv-lite": "0.7.3",
    "nodemailer": "10.0.10",
    "openai": "7.20.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "prom-client": "^15.1.3",
    "read-excel-file": "9.3.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "@types/nodemailer": "7.0.3",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "typescript": "5.9.3"
  }
}
