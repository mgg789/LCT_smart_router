{
  "name": "promo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Navix Router — presentation reel (Remotion motion design over real platform captures)",
  "scripts": {
    "prepare-stand": "node capture/prepare.ts",
    "prepare-stand:restart": "node capture/prepare.ts --restart",
    "probe": "node capture/probe.ts",
    "capture": "node capture/run.ts",
    "music": "node capture/music.ts",
    "encode": "node capture/encode.ts",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Reel out/navix-reel.mp4",
    "still": "remotion still src/index.ts Reel out/still.png",
    "typecheck": "tsc -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@remotion/google-fonts": "4.0.529",
    "@remotion/media-utils": "4.0.529",
    "@remotion/shapes": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.529",
    "@types/react": "^19.2.18",
    "ffmpeg-static": "^5.3.0",
    "playwright": "1.63.0",
    "typescript": "~5.9.3"
  }
}
