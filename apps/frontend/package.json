{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LCT Smart Router — dispatcher frontend (NAVIX design)",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174",
    "test": "vitest run",
    "test:watch": "vitest",
