# LCT Smart Router — environment template.
#
# Copy to `.env` in the repository root and fill in real values. The real file is
# git-ignored and never committed: secrets live in the environment, not in the
# repository, board cards or logs (AGENTS.md section 13.4).
#
# Application keys are validated at startup by apps/api/src/common/config/env.schema.ts
# and an unusable value stops the process. Infrastructure keys below that section are
# read by docker compose. Keys are added by the branch that starts using them, so this
# file always matches the code in the same commit.

# --- System Layer (apps/api) -------------------------------------------------
NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# --- Optional observability -------------------------------------------------
# Enable SDKs independently. No telemetry is exported while its flag is false.
METRICS_ENABLED=false
# Required only when enabled: independent random bearer secret, 32-512 characters.
METRICS_TOKEN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_TRACE_SAMPLE_RATIO=0.1
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
ROUTER_METRICS_ENABLED=false
ROUTER_METRICS_TOKEN=
ROUTER_OTEL_ENABLED=false
ROUTER_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
ROUTER_OTEL_TRACE_SAMPLE_RATIO=0.1
ROUTER_SENTRY_ENABLED=false
ROUTER_SENTRY_DSN=
# Browser options are baked into the web build. Public DSN only; never an auth token.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
# Optional local Prometheus/Collector services: COMPOSE_PROFILES=observability
# PROMETHEUS_PORT=9090

# IANA zone used only to render stored Unix seconds for humans. The offset is never
# added to a stored timestamp.
APP_TIME_ZONE=Europe/Moscow

# Business-writer connection. Inside compose the host is the service name `postgres`;
# running the service on the host against the compose database, use 127.0.0.1.
DATABASE_URL=postgresql://lct:lct_dev_password@127.0.0.1:5432/lct?schema=public

# Private Router API. Compose overrides the hostname with the internal service name.
ROUTER_BASE_URL=http://127.0.0.1:8100
ROUTER_POLL_INTERVAL_MS=500
ROUTER_REQUEST_TIMEOUT_MS=3000
# Optional demo acceleration: whole logical workday duration in wall-clock seconds.
# Leave empty for ordinary time; `3600` makes the logical day pass in one hour.
# speed_up_work_stub=3600
# Initial search budget for the compose `router` process (ms). Default 6000.
# Persisted Router technical settings can override subsequent calculation budgets.
# ROUTER_BUDGET_MS=6000

# Optional live OSRM for centroid / unknown legs. These variables belong to the
# Router process; the default compose service does not forward them automatically.
# Each endpoint must serve data extracted for that transport. Changing the API
# path does not change OSRM's compiled profile. Legacy URL means car ONLY.
# Unconfigured profiles keep local costs; transit is never sent to car OSRM.
# ROUTER_OSRM_URL=http://127.0.0.1:5000
# ROUTER_OSRM_CAR_URL=http://127.0.0.1:5000
# ROUTER_OSRM_WALK_URL=http://127.0.0.1:5001
# ROUTER_OSRM_BIKE_URL=http://127.0.0.1:5002
# ROUTER_OSRM_CACHE=.osrm-cache
# ROUTER_OSRM_MAP_VERSION=live
# ROUTER_OSRM_OFFLINE=false
# Batched car costs and departure-time forecast for planning; /route2 draws selected legs.
# Compose defaults to its bundled road-api service. Use a host URL for native runs.
# ROUTER_ROAD_API_URL=http://127.0.0.1:8123
# API-only road geometry; compose supplies http://road-api:8123 automatically.
# Outside compose, this takes precedence over the legacy ROUTER_ROAD_API_URL fallback.
# API_ROAD_API_URL=http://127.0.0.1:8123
# ROUTER_ROAD_API_CACHE=.road-api-cache
# ROUTER_ROAD_API_MAP_VERSION=moscow-mkad
# ROUTER_ROAD_API_OFFLINE=true

# Optional: connection used by `prisma migrate deploy`. A deployment points this at the
# migration owner; left empty, the CLI falls back to DATABASE_URL.
# MIGRATE_DATABASE_URL=

# --- auth-engine -------------------------------------------------------------
# There is exactly one dispatcher, and both sign-in paths open that same account.
# The password path exists so the Dashboard stays reachable when the mail contour is
# down, so it must never be left at this placeholder in a deployed contour.
DISPATCHER_EMAIL=dispatcher@example.test
DISPATCHER_PASSWORD=change-me-before-deploying

# Lifetimes in seconds. The concept leaves these to the auth-engine and names no numbers;
# these are implementation defaults, not agreed norms.
SESSION_TTL_SEC=86400
# Engineer App device sessions. Dispatcher sessions stay on SESSION_TTL_SEC.
ENGINEER_SESSION_TTL_SEC=2592000
LOGIN_CODE_TTL_SEC=600
LOGIN_CODE_MAX_ATTEMPTS=5

# Development only: returns the login code in the API response, because this build has no
# SMTP-gateway to deliver it. The application refuses to start with this enabled in
# production -- an exposed code is a complete authentication bypass. Default false:
# enable it deliberately for a local contour without SMTP.
AUTH_DEV_EXPOSE_CODES=false

# --- SMTP-gateway ------------------------------------------------------------
# Leave SMTP_HOST empty to keep mail `not_configured`. Inside compose the
# Hysteria forwards are on the host: use host.docker.internal (see extra_hosts
# on `api`). Fallback is the public submission port opened only by the watchdog.
# SMTP_HOST=host.docker.internal
# SMTP_PORT=2525
# SMTP_USER=navix-sys
# SMTP_PASSWORD=
# SMTP_FROM=Navix <noreply@mail.droidje.com>
# SMTP_FALLBACK_HOST=mail.droidje.com
# SMTP_FALLBACK_PORT=587
# SMTP_HEALTH_URL=http://host.docker.internal:8587/health
# SMTP_POLL_INTERVAL_MS=15000
# SMTP_APP_BASE_URL=https://navix.droidje.com

# Optional LocationIQ key for dispatcher and client address search. Without the key
# the same calls fall back to Nominatim, paced to one request per second, so a local
# stand still resolves an address (just slower and rate-limited).
# LOCATION_IQ_TOKEN=

# --- AI-gateway (System Layer, apps/api) --------------------------------------
# `off` keeps the chat surface and the AI tab honestly disabled. `replay` reads
# recorded fixtures and needs no network at all -- that is what keeps the offline
# demo contour possible. `agents` and `openai_chat` talk to a real OpenAI-compatible
# endpoint; a live provider requires LLM_TOKEN.
LLM_PROVIDER=off
# LLM_TOKEN=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# Chat adapter only: opt into low thinking on a compatible DeepSeek endpoint.
# Low requires LLM_PROVIDER=openai_chat and LLM_FALLBACK_PROVIDER=none.
# Private reasoning and final output share the output-token budget.
# LLM_CHAT_REASONING_EFFORT=none
# LLM_MAX_OUTPUT_TOKENS=4096
# X-Proxy-Token for an authenticating reverse proxy in front of the provider
# (openrouter.droidje.com): the proxy injects the real provider key server-side
# and only checks this token. Leave empty for direct provider endpoints.
# LLM_PROXY_TOKEN=
# LLM_FALLBACK_PROVIDER=none
# LLM_MAX_ATTEMPTS=2
# Daily/total assistant budgets (see env.schema.ts for the full list of AI_ keys).
# AI_DAILY_MESSAGE_LIMIT=30
# AI_DAILY_COST_LIMIT_MICROS=200000
# AI_TOTAL_COST_LIMIT_MICROS=4000000

# Multiplier on the per-IP request budgets of the public auth and paid client
# endpoints (login codes 5/min, verify and password 10/min, paid client proxy
# 30/min). Raise it when the edge in front of the API already rate-limits.
RATE_LIMIT_MULTIPLIER=1

# System one (fast typed decisions: /v1/choice, /v1/noul). Two deployments:
# - a developer machine runs jev-local on the host, so the container reaches it
#   through host.docker.internal;
# - the demo stand uses the compose `sys1` service (services/sys1), which answers
#   the same contract from the OpenRouter mirror; point JEV_API_URL at it and set
#   SYS1_LLM_BASE_URL / SYS1_MODEL (its token is LLM_PROXY_TOKEN).
# Where neither is reachable, the guard refuses and short AI calls report
# not_configured.
# JEV_API_URL=http://host.docker.internal:12444
# SYS1_LLM_BASE_URL=https://openrouter.droidje.com/api/v1
# SYS1_MODEL=typesafe/jev-1.13

# Public demo stand only (navix.droidje.com). Seeds today's 14/3 live-demo, keeps the
# logical day at 30 wall-clock minutes, and rewinds after the shift or «День заново».
# Set DEMO_STAND=false for a plain local contour; compose defaults to true.
# DEMO_STAND=true
# speed_up_work_stub=1800

# --- dataset -----------------------------------------------------------------
# Where the organisers' CSV files live. Inside compose this is a read-only mount.
DATASET_ROOT=data/dataset/anonymized

# Offset of the local times printed in those files, in seconds. Stated explicitly: the
# files say "17.08.2026 20:00" with no zone, and reading them elsewhere would move every
# window.
DATASET_TIME_ZONE_OFFSET_SEC=10800

# --- PostgreSQL (infra/docker-compose.yml) -----------------------------------
# Used by compose to initialise the database container. The password below is a
# local development value; a deployed contour must set a real one.
POSTGRES_USER=lct
POSTGRES_PASSWORD=lct_dev_password
POSTGRES_DB=lct
ROUTER_DB_PASSWORD=router_dev_password

# Host-side ports. Postgres, API and the router stay on 127.0.0.1. On the MGG demo
# host remap occupied ports (`API_PORT=18080`, `ROUTER_PORT=18100`);
# the public gate is host nginx → web on 127.0.0.1:5173 (docs/ci.md).
POSTGRES_PORT=5432
API_PORT=8000
ROUTER_PORT=8100
WEB_PORT=5173
# Optional Redis-beta catalog cache. Launcher configures the URL/password/namespace privately.
ROUTER_REDIS_BETA=false
ROUTER_REDIS_URL=
ROUTER_REDIS_NAMESPACE=lct-smart-router
ROUTER_REDIS_TTL_SEC=600
REDIS_PASSWORD=
