# LCT Smart Router — environment template.
#
# Copy to `infra/.env` (compose) or `.env` (local run) and fill in real values. The real
# file is git-ignored and never committed: secrets live in the environment, not in the
# repository, board cards or logs (AGENTS.md section 13.4).
#
# Every key here is validated at startup by apps/api/src/common/config/env.schema.ts.
# Keys are added by the branch that starts reading them, so this file always matches the
# code in the same commit.

# --- System Layer (apps/api) -------------------------------------------------
NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# IANA zone used only to render stored Unix seconds for humans. The offset is never
# added to a stored timestamp.
APP_TIME_ZONE=Europe/Moscow
