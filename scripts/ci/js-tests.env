# Public disposable values for the JS test cube (same pattern as
# tests/e2e/contour.env). The LCT_CI_PG_PASSWORD repository secret injected by
# .sourcecraft/ci.yaml overrides this file, so the committed value only guards
# the throwaway loopback Postgres sidecar when the workflow config on the
# default branch does not carry the secret env yet.
LCT_CI_PG_PASSWORD=lct_ci_password
